# VITE_OPENWEATHER_API_KEY: OpenWeather API key for live weather, forecast, AQI, geocoding, and One Call 3.0 UV data.
# When omitted, Weatherly automatically falls back to Open-Meteo (no key required).
VITE_OPENWEATHER_API_KEY=""

# GEMINI_API_KEY: Optional server/environment key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
